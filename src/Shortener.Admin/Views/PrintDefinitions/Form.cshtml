@model Shortener.Admin.Models.PrintDefinitionFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "ایجاد نام چاپ" : "ویرایش نام چاپ";
}
<h3>@ViewData["Title"]</h3>
<div class="row">
    <div class="col-md-6">
        <form asp-action="@(Model.Id is null ? "Create" : "Edit")" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ClientId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
                <div class="form-text">همان کد چاپی (ReportId) که در بارگذاری‌های این کلاینت ارسال می‌شود.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">ذخیره</button>
            <a asp-action="Index" asp-route-clientId="@Model.ClientId" class="btn btn-outline-secondary">انصراف</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
