@model List<Shortener.Admin.Models.ClientListItemViewModel>
@{
    ViewData["Title"] = "کلاینت‌ها";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>کلاینت‌ها</h3>
    <a class="btn btn-primary" asp-action="Create">ایجاد کلاینت جدید</a>
</div>
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>نام</th>
            <th>کد</th>
            <th>وضعیت</th>
            <th>حساب‌های پیامکی</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model)
        {
            <tr>
                <td>@client.Name</td>
                <td><code>@client.Code</code></td>
                <td>
                    @if (client.IsActive)
                    {
                        <span class="badge bg-success">فعال</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">غیرفعال</span>
                    }
                </td>
                <td>
                    @if (!client.HasBulkAccount || !client.HasOtpAccount)
                    {
                        <span class="badge bg-danger" title="این کلاینت هر دو حساب پیامکی (انبوه و OTP) را ندارد">
                            ناقص
                            @(client.HasBulkAccount ? "" : "(بدون انبوه)")
                            @(client.HasOtpAccount ? "" : "(بدون OTP)")
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">کامل</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@client.Id">ویرایش</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="ApiKeys" asp-action="Index" asp-route-clientId="@client.Id">کلیدهای API</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="SmsAccounts" asp-action="Index" asp-route-clientId="@client.Id">حساب‌های پیامکی</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="MessageTemplates" asp-action="Index" asp-route-clientId="@client.Id">قالب‌ها</a>
                </td>
            </tr>
        }
    </tbody>
</table>
