@model Shortener.Admin.Models.RetentionPolicyFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? "ایجاد سیاست نگهداشت" : "ویرایش سیاست نگهداشت";
}
<h3>@ViewData["Title"]</h3>
<div class="row">
    <div class="col-md-7">
        <form asp-action="@(Model.Id is null ? "Create" : "Edit")" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            @if (Model.Id is null)
            {
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ClientId" class="form-label"></label>
                        <select asp-for="ClientId" id="client-select" class="form-select">
                            <option value="">— سراسری —</option>
                            @foreach (var client in Model.Clients)
                            {
                                <option value="@client.Id">@client.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="ReportId" class="form-label"></label>
                        <input asp-for="ReportId" id="report-id-input" class="form-control" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="BatchTag" class="form-label"></label>
                        <input asp-for="BatchTag" id="batch-tag-input" class="form-control" />
                    </div>
                </div>
            }
            else if (Model.IsGlobal)
            {
                <div class="alert alert-info">این سیاست سراسری است (برای همه کلاینت‌ها اعمال می‌شود) و قابل حذف نیست.</div>
            }

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="RetentionDays" class="form-label"></label>
                    <input asp-for="RetentionDays" id="retention-days-input" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="GraceDays" class="form-label"></label>
                    <input asp-for="GraceDays" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Priority" class="form-label"></label>
                    <input asp-for="Priority" class="form-control" />
                </div>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">ذخیره</button>
            <a asp-action="Index" class="btn btn-outline-secondary">انصراف</a>
        </form>
    </div>

    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">پیش‌نمایش اثر</h5>
                <p class="text-muted small">قبل از ذخیره، ببینید این سیاست روی چند فایل موجود اثر می‌گذارد.</p>
                <button type="button" id="btn-preview" class="btn btn-outline-primary btn-sm">محاسبه پیش‌نمایش</button>
                <div id="preview-result" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('btn-preview').addEventListener('click', async () => {
            const clientId = document.getElementById('client-select')?.value || '';
            const reportId = document.getElementById('report-id-input')?.value || '';
            const batchTag = document.getElementById('batch-tag-input')?.value || '';
            const retentionDays = document.getElementById('retention-days-input')?.value || '@Model.RetentionDays';

            const params = new URLSearchParams({ retentionDays });
            if (clientId) params.set('clientId', clientId);
            if (reportId) params.set('reportId', reportId);
            if (batchTag) params.set('batchTag', batchTag);

            const resultBox = document.getElementById('preview-result');
            resultBox.textContent = 'در حال محاسبه...';

            try {
                const res = await fetch('@Url.Action("PreviewImpact")?' + params.toString());
                const body = await res.json();
                resultBox.innerHTML =
                    `<div>تعداد فایل‌های تحت تأثیر: <strong>${body.affectedFileCount}</strong></div>` +
                    `<div>فایل‌هایی که بلافاصله منقضی می‌شوند: <strong>${body.immediatelyExpiringCount}</strong></div>`;
            } catch {
                resultBox.textContent = 'خطا در محاسبه پیش‌نمایش.';
            }
        });
    </script>
}
