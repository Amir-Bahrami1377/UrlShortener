@using Shortener.Application.Services
@model Shortener.Admin.Models.SmsReportViewModel
@{
    ViewData["Title"] = "گزارش پیامک‌ها";
}
<h3 class="mb-3">گزارش پیامک‌ها</h3>

<form method="get" class="row row-cols-lg-auto g-2 align-items-end mb-3">
    <div class="col"><label class="form-label small">از تاریخ (شمسی)</label><input name="FromDate" value="@Model.Filter.FromDate" class="form-control form-control-sm" placeholder="1405/01/01" /></div>
    <div class="col"><label class="form-label small">تا تاریخ (شمسی)</label><input name="ToDate" value="@Model.Filter.ToDate" class="form-control form-control-sm" placeholder="1405/12/29" /></div>
    <div class="col">
        <label class="form-label small">کلاینت</label>
        <select name="ClientId" class="form-select form-select-sm">
            <option value="">همه</option>
            @foreach (var c in Model.Clients)
            {
                <option value="@c.Id" selected="@(Model.Filter.ClientId == c.Id)">@c.Name</option>
            }
        </select>
    </div>
    <div class="col">
        <label class="form-label small">نوع پیام</label>
        <select name="MessageType" class="form-select form-select-sm">
            <option value="">همه</option>
            <option value="DownloadLink" selected="@(Model.Filter.MessageType == "DownloadLink")">لینک دانلود</option>
            <option value="Otp" selected="@(Model.Filter.MessageType == "Otp")">OTP</option>
        </select>
    </div>
    <div class="col">
        <label class="form-label small">وضعیت</label>
        <select name="Status" class="form-select form-select-sm">
            <option value="">همه</option>
            @foreach (var s in new[] { "Pending", "Queued", "Sending", "Sent", "Delivered", "Failed", "Undelivered", "Cancelled" })
            {
                <option value="@s" selected="@(Model.Filter.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col"><label class="form-label small">شماره تلفن</label><input name="PhoneNumber" value="@Model.Filter.PhoneNumber" class="form-control form-control-sm" /></div>
    <div class="col"><button type="submit" class="btn btn-primary btn-sm">فیلتر</button></div>
    <div class="col"><a class="btn btn-outline-success btn-sm" href="@Url.Action("ExportSms")@Context.Request.QueryString">خروجی Excel</a></div>
</form>

<h5>خلاصه هزینه و تعداد بر اساس کلاینت و نوع پیام</h5>
<table class="table table-sm table-bordered w-auto mb-4">
    <thead><tr><th>کلاینت</th><th>نوع</th><th>تعداد</th><th>هزینه</th></tr></thead>
    <tbody>
        @foreach (var agg in Model.Aggregates)
        {
            <tr>
                <td>@agg.ClientName</td>
                <td>@(agg.MessageType == "Otp" ? "OTP" : "لینک دانلود")</td>
                <td>@agg.Count</td>
                <td>@agg.TotalCost.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted small">تعداد کل نتایج: @Model.TotalCount (حداکثر ۱۰۰ نتیجه اول نمایش داده می‌شود)</p>
<div class="table-responsive">
<table class="table table-striped table-sm align-middle">
    <thead>
        <tr><th>کلاینت</th><th>نوع</th><th>شماره</th><th>وضعیت</th><th>هزینه</th><th>ایجاد</th><th>ارسال</th><th>تحویل</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.ClientName</td>
                <td>@(row.MessageType == "Otp" ? "OTP" : "لینک دانلود")</td>
                <td>@row.PhoneNumber</td>
                <td>@row.Status</td>
                <td>@(row.Cost?.ToString("N0") ?? "—")</td>
                <td>@row.CreatedAt.ToPersianDateTime()</td>
                <td>@row.SentAt.ToPersianDateTime()</td>
                <td>@row.DeliveredAt.ToPersianDateTime()</td>
                <td>
                    @if (row.CanResend && (User.IsInRole("SuperAdmin") || User.IsInRole("Operator")))
                    {
                        <form asp-action="ResendSms" method="post" onsubmit="return confirm('این پیام دوباره ارسال شود؟');">
                            <input type="hidden" name="id" value="@row.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">ارسال مجدد</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
