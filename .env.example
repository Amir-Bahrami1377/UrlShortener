# Copy this file to `.env` (already gitignored — never commit the real one) before running
# `docker compose up` with docker-compose.yml (the production-shaped stack). Docker Compose loads
# `.env` automatically from the same directory to fill in the ${VAR} references in that file.
#
# docker-compose.dev.yml (the Windows-host dev loop) does NOT use these — its SQL Server password
# is hardcoded to a known local-only value on purpose, see that file's own comments.

# SQL Server `sa` password. Falls back to a placeholder if unset, but that placeholder is public
# (it's in this repo) — always set a real value before this stack runs anywhere but a throwaway
# local check.
SQL_SA_PASSWORD=Change_Me_Before_Prod1

# HMAC secret OtpService uses to hash OTP codes before storing them in Redis (never the raw code).
# Compose has no fallback for this one — it refuses to start Worker without it. Generate one with:
#   openssl rand -hex 32
OTP_HMAC_SECRET=

# Domains Caddy (the reverse proxy that terminates TLS for this stack — see ./Caddyfile) routes to
# each app. Defaults are *.localhost, fine for a local check. For a real deployment, point these at
# real DNS names that resolve to this host.
PUBLICWEB_DOMAIN=localhost
API_DOMAIN=api.localhost
ADMIN_DOMAIN=admin.localhost

# "internal" = Caddy issues its own self-signed certs (browsers will warn — expected for local use).
# Set this to a real email address once the domains above are real and publicly resolving; Caddy
# then gets real certs from Let's Encrypt automatically for every site in ./Caddyfile.
CADDY_TLS_MODE=internal
